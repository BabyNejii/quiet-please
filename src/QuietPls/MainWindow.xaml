<Window x:Class="QuietPls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiet, Pls"
        Height="680" Width="540"
        MinHeight="600" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="#121216"
        Foreground="#ECECF1"
        Icon="Resources/app.png"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECECF1"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#1A1A22"/>
            <Setter Property="BorderBrush" Value="#2A2A38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#252532"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#38384C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#343446"/>
                    <Setter Property="BorderBrush" Value="#4C4C66"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#FF1744"/>
            <Setter Property="BorderBrush" Value="#FF4569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D50000"/>
                    <Setter Property="BorderBrush" Value="#FF1744"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="QUIET, PLS" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Low-footprint gamer voice awareness" FontSize="12" Foreground="#8E8EA0" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="MuteToggleBtn" Click="MuteToggleBtn_Click"
                        Style="{StaticResource ActionButton}" Padding="14,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="MuteStatusDot" Width="8" Height="8" Fill="#00E676" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="MuteStatusText" Text="Active" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Device Selection Card -->
            <Border Grid.Row="1" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="MICROPHONE" FontSize="11" FontWeight="Bold" Foreground="#8E8EA0" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="DeviceComboBox" SelectionChanged="DeviceComboBox_SelectionChanged"
                                  Background="#121216" Foreground="#121216" Padding="8,6" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Refresh" Margin="8,0,0,0" Padding="10,6"
                                Style="{StaticResource ActionButton}" Click="RefreshDevices_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Live Volume & Calibration Card -->
            <Border Grid.Row="2" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="LIVE CALIBRATION &amp; THRESHOLD" FontSize="11" FontWeight="Bold" Foreground="#8E8EA0"/>
                        <TextBlock x:Name="StatusBadge" Text="Normal" HorizontalAlignment="Right"
                                   FontSize="11" FontWeight="Bold" Foreground="#00E676"/>
                    </Grid>

                    <!-- Real-time Meter -->
                    <Grid Height="18" Margin="0,0,0,6">
                        <Border Background="#121216" CornerRadius="4" BorderBrush="#2A2A38" BorderThickness="1"/>
                        <ProgressBar x:Name="VolumeProgressBar" Minimum="0" Maximum="100" Value="0"
                                     Foreground="#00E676" Background="Transparent" BorderThickness="0"/>
                        <TextBlock x:Name="VolumePercentText" Text="0%" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Grid>

                    <!-- Threshold Slider -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Shout Trigger Threshold:" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="ThresholdValueLabel" Text="55%" FontWeight="Bold"
                                   Foreground="#FF1744" VerticalAlignment="Center"/>
                    </Grid>
                    <Slider x:Name="ThresholdSlider" Minimum="5" Maximum="95" Value="55" Margin="0,4,0,0"
                            ValueChanged="ThresholdSlider_ValueChanged" SmallChange="1" LargeChange="5"/>
                    <TextBlock Text="Speak normally: the bar should stay below the threshold. Shout: it should cross it."
                               FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Escalation Timers Card -->
            <Border Grid.Row="3" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="ALERT TIMING &amp; ESCALATION" FontSize="11" FontWeight="Bold" Foreground="#8E8EA0" Margin="0,0,0,10"/>

                    <!-- Warning Duration -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Level 1: Visual Pulse Delay" FontSize="13"/>
                        <TextBlock Grid.Column="1" x:Name="WarningDelayLabel" Text="150 ms" FontWeight="SemiBold"/>
                    </Grid>
                    <Slider x:Name="WarningDelaySlider" Minimum="50" Maximum="400" Value="150" Margin="0,4,0,10"
                            ValueChanged="WarningDelaySlider_ValueChanged"/>

                    <!-- Escalation Duration -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Level 2: Audio Chime Delay (Continued Yelling)" FontSize="13"/>
                        <TextBlock Grid.Column="1" x:Name="EscalationDelayLabel" Text="1200 ms" FontWeight="SemiBold"/>
                    </Grid>
                    <Slider x:Name="EscalationDelaySlider" Minimum="600" Maximum="3000" Value="1200" Margin="0,4,0,0"
                            ValueChanged="EscalationDelaySlider_ValueChanged"/>
                </StackPanel>
            </Border>

            <!-- Notification Channels & Testing Card -->
            <Border Grid.Row="4" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="NOTIFICATION CHANNELS" FontSize="11" FontWeight="Bold" Foreground="#8E8EA0" Margin="0,0,0,10"/>

                    <CheckBox x:Name="VisualToggle" Content="Enable Screen Border Pulse (Visual)"
                              IsChecked="True" Checked="VisualToggle_Changed" Unchecked="VisualToggle_Changed"
                              Foreground="#ECECF1" Margin="0,0,0,8"/>
                    <CheckBox x:Name="AudioToggle" Content="Enable Headset Warning Chime (Audio)"
                              IsChecked="True" Checked="AudioToggle_Changed" Unchecked="AudioToggle_Changed"
                              Foreground="#ECECF1" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Test Visual Pulse" Style="{StaticResource ActionButton}"
                                Click="TestVisual_Click"/>
                        <Button Grid.Column="2" Content="Test Audio Chime" Style="{StaticResource ActionButton}"
                                Click="TestAudio_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Footer Buttons -->
            <Grid Grid.Row="5" Margin="0,4,0,0">
                <Button Content="Minimize to Tray" Style="{StaticResource PrimaryButton}"
                        Padding="18,10" HorizontalAlignment="Right" Click="MinimizeToTray_Click"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
